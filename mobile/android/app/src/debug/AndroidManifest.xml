<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Debug-only: Flutter's hot reload/dev service needs a local socket.
         This permission is absent from release and profile builds. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="replace" />
</manifest>
